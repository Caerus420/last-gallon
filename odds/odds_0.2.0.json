{
  "game": "Last Gallon: Zombie Car Smash",
  "version": "0.2.0",
  "decimals": 4,
  "paid_random_items": false,
  "how_boxes_are_got": "Boxes are earned only: driving, GALLON RUN stars, horde nights held and first stage clears. Money and GOLD BARS never buy a box. What a box holds is fixed when it is earned. Boxes arrive sealed: you can peek inside any time, and the full contents are always shown before any GOLD BARS are spent on a box. GOLD BARS can only open it sooner.",
  "reference_player": "These are the odds before any CREW lean or pity: no cards owned, no CREW pinned, pity counters at 0. The game's ODDS sheet shows each player's own odds from the same roll.",
  "crew_lean": "A ROADSIDE, HARDENED or ELITE stack is one of the player's CREW cards of that rarity half the time (the 4 pinned cards, or the 4 survivors who ran most recently), else even over every card of that rarity. LEGEND stacks are always even.",
  "pity": {
    "elite": "The 6th TOOLBOX-or-better box in a row without an ELITE line always has one.",
    "legend": "The 40th TOOLBOX-or-better box in a row without a LEGEND brings the player's WISHLIST character (or the first LEGEND character not owned; in a GUN CASE a LEGEND gun not owned).",
    "rules": "Pity is counted when a box is earned and never resets or expires."
  },
  "legend_gate": "LEGEND lines open once stage 3 has been cleared.",
  "daily_limit": "At most 8 boxes a day from driving, runs and nights; past that the meter pays scrap instead. Paying never changes it.",
  "first_clears": "The first clear of a stage gives a GUN CASE (an ARMY CRATE at stages 5, 10 and 15), once per install.",
